{
    "name": "nswdpc/silverstripe-csp",
    "description": "SilverStripe Content Security Policy module",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "csp",
        "content security policy"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "James Ellis",
            "homepage": "https://dpc.nsw.gov.au",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "NSWDPC\\Utilities\\ContentSecurityPolicy\\": [
                "src/Controllers",
                "src/Extensions",
                "src/Jobs",
                "src/Middleware",
                "src/Models",
                "src/Services/",
                "src/Traits"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NSWDPC\\Utilities\\ContentSecurityPolicy\\Tests\\": "tests/"
        }
    },
    "require": {
        "ext-xml": "*",
        "silverstripe/cms": "^6",
        "symbiote/silverstripe-queuedjobs": "^6",
        "symbiote/silverstripe-multivaluefield": "dev-7 || ^7"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "cambis/silverstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "nswdpc/ci-files": "dev-v-4",
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
